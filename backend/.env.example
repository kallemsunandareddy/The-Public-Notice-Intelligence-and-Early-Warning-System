# Database
DATABASE_URL=sqlite:///./civic_notices.db
# For production PostgreSQL: postgresql://postgres:postgres@localhost:5432/civic_notices

# Security
SECRET_KEY=civic-public-notice-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration
GEMINI_API_KEY=
# Leave empty to enable the intelligent resilient built-in civic NLP engine

# Notification Services (Mockable/Configurable)
FCM_SERVER_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_API_KEY=
SMS_SENDER_ID=CIVICINFO

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:19006","http://localhost:8081"]

